# Response headers for Cloudflare Pages.
#
# In the repo rather than the Cloudflare dashboard, deliberately: these are part
# of how the site behaves, they should be reviewable in a diff, and a dashboard
# setting nobody can see from the code is a setting nobody maintains.
#
# The site already scored A+ at SSL Labs on all four endpoints before this file
# existed. What was missing was not transport security but browser policy.

/*
  # Clickjacking. A data platform's credibility depends on figures appearing in
  # their own context; framing lets someone wrap our numbers in their framing.
  # frame-ancestors is the modern control, X-Frame-Options the fallback for
  # older browsers that ignore CSP.
  X-Frame-Options: DENY

  # 'unsafe-inline' for scripts is not laziness. Next's static export emits
  # inline hydration payloads and there is no server to mint a per-request
  # nonce, so a nonce-based policy is not available to this architecture.
  # Everything else is locked to 'self': no third-party scripts, no analytics,
  # no fonts or frames from anywhere.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

  # The site asks for no camera, microphone, location or payment. Saying so
  # explicitly means a future dependency cannot start asking quietly.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# The published data is meant to be read from anywhere -- that is the point of
# the platform -- so the data directory keeps its open CORS header. The HTML
# does not need one.
/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/search-index.json
  Access-Control-Allow-Origin: *
