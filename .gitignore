# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# dlt
.dlt/secrets.toml
**/_storage/

# dbt
transform/target/
transform/dbt_packages/
transform/logs/
.user.yml

# The warehouse is a build artefact; the pipeline reproduces it.
warehouse/
data/raw/
data/staging/

# publish/dist IS the product, and it is committed on purpose:
#   - it gives the published data a version history, so a figure that changes
#     can be traced to the commit that changed it
#   - it lets Cloudflare Pages build the site with Node alone, instead of
#     running the whole Python pipeline inside the build image
# Regenerate with `python -m publish.export`; never hand-edit.
*.duckdb
*.duckdb.wal

# Never commit source data containing personal information. The platform
# publishes aggregates only; row-level records stay out of version control
# and off any public host.
**/voter_list*.duckdb
**/voters*.csv

# Env
.env
.env.*
!.env.example

# OS / editors
.DS_Store
.vscode/
.idea/

# Next.js
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/public/data/
